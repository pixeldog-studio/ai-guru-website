:"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":668.98},{"type":"text","id":"t2a1","name":"3. Research Synthesis","content":"3. Research Synthesis","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":766.57},{"type":"text","id":"t2a2","name":"Need to understand a complex topic quick","content":"Need to understand a complex topic quickly? Paste in your notes, articles or reports and\nAI can condense them into a clear summary in seconds.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":811.37},{"type":"text","id":"t2a3","name":"4. Code Review","content":"4. Code Review","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":908.96},{"type":"text","id":"t2a4","name":"Whether you’re a developer or just learn","content":"Whether you’re a developer or just learning, AI can review your code, spot bugs,\nsuggest improvements, and explain complex patterns.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":953.76},{"type":"text","id":"t2a5","name":"5. Content Repurposing","content":"5. Content Repurposing","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1051.35},{"type":"text","id":"t2a6","name":"Turn a blog post into social media posts","content":"Turn a blog post into social media posts, a newsletter, or a presentation outline. AI can\nadapt your content for any format or platform.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":1096.15},{"type":"text","id":"t2a7","name":"6. Data Analysis","content":"6. Data Analysis","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1193.74},{"type":"text","id":"t2a8","name":"Drop your data into an AI model and ask ","content":"Drop your data into an AI model and ask questions in plain language. Get insights\nwithout writing a single line of SQL or Python.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":1238.54},{"type":"text","id":"t2a9","name":"7. Language Translation","content":"7. Language Translation","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1336.13},{"type":"text","id":"t2aa","name":"AI models handle nuanced translations fa","content":"AI models handle nuanced translations far better than simple translation tools,\npreserving tone, context, and cultural references.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":1380.93},{"type":"text","id":"t2ab","name":"8. Brainstorming Partner","content":"8. Brainstorming Partner","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1478.52},{"type":"text","id":"t2ac","name":"Stuck on a problem? Use AI as a brainsto","content":"Stuck on a problem? Use AI as a brainstorming partner. It can generate ideas, play\ndevil’s advocate, and help you think through solutions.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":1523.32},{"type":"text","id":"t2ad","name":"9. Document Organization","content":"9. Document Organization","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1620.91},{"type":"text","id":"t2ae","name":"Let AI help you organize, categorize, an","content":"Let AI help you organize, categorize, and tag large volumes of documents, emails, or\nnotes.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":1665.71},{"type":"text","id":"t2af","name":"10. Learning Accelerator","content":"10. Learning Accelerator","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1763.3},{"type":"text","id":"t2ag","name":"Use AI to explain complex concepts, crea","content":"Use AI to explain complex concepts, create study guides, or generate practice problems\ntailored to your skill level.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":668.5,"x":20,"y":1808.1},{"type":"text","id":"t2ah","name":"Start Today","content":"Start Today","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1905.69},{"type":"text","id":"t2ai","name":"The key to AI productivity is starting s","content":"The key to AI productivity is starting small. Pick one