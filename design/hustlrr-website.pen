"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":57,"y":2153.66},{"type":"text","id":"t33k","name":": Use Claude to draft potential user per","content":": Use Claude to draft potential user personas.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":219.11,"y":2153.66},{"type":"text","id":"t33l","name":"Analyze competitors","content":"Analyze competitors","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":57,"y":2190.46},{"type":"text","id":"t33m","name":": Ask Gemini to summarize existing tools","content":": Ask Gemini to summarize existing tools in the space.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":215.59,"y":2190.46},{"type":"text","id":"t33n","name":"Test the concept","content":"Test the concept","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":57,"y":2227.26},{"type":"text","id":"t33o","name":": Have GPT draft a simple landing page c","content":": Have GPT draft a simple landing page copy or a pitch.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":185.58,"y":2227.26},{"type":"text","id":"t33p","name":"By doing this, you’re not only saving ti","content":"By doing this, you’re not only saving time and money, but also gaining clarity on whether your idea is worth pursuing.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":768.5,"x":33,"y":2276.05},{"type":"text","id":"t33q","name":"How Hustlrr.ai Fits In","content":"How Hustlrr.ai Fits In","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":33,"y":2373.65},{"type":"text","id":"t33r","name":"While AI tools are powerful, they can so","content":"While AI tools are powerful, they can sometimes feel scattered. You’re switching between tools, copying and pasting, trying to piece together insights.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":768.5,"x":33,"y":2418.44},{"type":"text","id":"t33s","name":"This is where Hustlrr.ai comes in. It’s ","content":"This is where Hustlrr.ai comes in. It’s designed to help you streamline your idea validation process by integrating the best of AI tools into a single, easy-to-use interface. You can ask Hustlrr to evaluate your idea, generate a report, and even suggest next steps—all without leaving the app.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":768.5,"x":33,"y":2496.04},{"type":"text","id":"t33t","name":"It’s not about replacing AI tools, but a","content":"It’s not about replacing AI tools, but about making them work better together.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":33,"y":2602.43},{"type":"text","id":"t33u","name":"Final Thoughts","content":"Final Thoughts","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":33,"y":2671.23},{"type":"text","id":"t33v","name":"AI is not a magic bullet, but it’s a pow","content":"AI is not a magic bullet, but it’s a powerful ally in the early stages of your startup journey. It can help you avoid costly mistakes, gain clarity, and speed up the validation process.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":768.5,"x":33,"y":2716.02},{"type":"text","id":"t33w","name":"If you’re thinking about launching a new","content":"If you’re thinking about launching a new idea, don’t skip the validation step. Use AI tools to test your assumptions and get feedback before you invest everything.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":768.5,"x":33,"y":2793.62},{"type":"text","id":"t33x","name":"And if you want to make that process eve","content":"And if you want to make that process even easier, try Hustlrr.ai. It’s built for founders who want to validate fast and move forward with confidence.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":768.5,"x":33,"y":2871.21},{"type":"text","id":"t33y","name":"👉","content":"👉","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":33,"y":2948.8},{"type":"text","id":"t33z","name":"Start validating your ideas with Hustlrr","content":"Start validating your ideas with Hustlrr.ai","fill":"$accent","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","underline":true,"x":57.45,"y":2948.8},{"type":"frame","id":"f34d","name":"div.mt-16","x":33,"y":3042,"width":768,"height":458,"stroke":"$border","strokeWidth":{"top":1,"right":0,"bottom":0,"left":0},"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"f34c","name":"form.seva-form","x":84,"y":49,"