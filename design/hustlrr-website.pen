"$lineHeight-1_8","textGrowth":"fixed-width","width":350.5,"x":20,"y":1211.33},{"type":"text","id":"t15q","name":"5. Content Repurposing","content":"5. Content Repurposing","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1337.73},{"type":"text","id":"t15r","name":"Turn a blog post into social media posts","content":"Turn a blog post into social media posts, a newsletter, or a presentation outline. AI can adapt your content for any format or platform.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":350.5,"x":20,"y":1382.52},{"type":"text","id":"t15s","name":"6. Data Analysis","content":"6. Data Analysis","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1508.91},{"type":"text","id":"t15t","name":"Drop your data into an AI model and ask ","content":"Drop your data into an AI model and ask questions in plain language. Get insights without writing a single line of SQL or Python.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":350.5,"x":20,"y":1553.71},{"type":"text","id":"t15u","name":"7. Language Translation","content":"7. Language Translation","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1680.1},{"type":"text","id":"t15v","name":"AI models handle nuanced translations fa","content":"AI models handle nuanced translations far better than simple translation tools, preserving tone, context, and cultural references.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":350.5,"x":20,"y":1724.9},{"type":"text","id":"t15w","name":"8. Brainstorming Partner","content":"8. Brainstorming Partner","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":1851.29},{"type":"text","id":"t15x","name":"Stuck on a problem? Use AI as a brainsto","content":"Stuck on a problem? Use AI as a brainstorming partner. It can generate ideas, play devil’s advocate, and help you think through solutions.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":350.5,"x":20,"y":1896.08},{"type":"text","id":"t15y","name":"9. Document Organization","content":"9. Document Organization","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":2051.27},{"type":"text","id":"t15z","name":"Let AI help you organize, categorize, an","content":"Let AI help you organize, categorize, and tag large volumes of documents, emails, or notes.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":350.5,"x":20,"y":2096.07},{"type":"text","id":"t160","name":"10. Learning Accelerator","content":"10. Learning Accelerator","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":20,"y":2193.66},{"type":"text","id":"t161","name":"Use AI to explain complex concepts, crea","content":"Use AI to explain complex concepts, create study guides, or generate practice problems tailored to your skill level.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$f