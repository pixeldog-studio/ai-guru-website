": Analysis, careful reasoning, long-docu","content":": Analysis, careful reasoning, long-document processing","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":414.08,"y":612.18},{"type":"text","id":"t36m","name":"Gemini","content":"Gemini","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":360,"y":648.98},{"type":"text","id":"t36n","name":": Multimodal tasks, data processing, vis","content":": Multimodal tasks, data processing, visual understanding","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":413.69,"y":648.98},{"type":"text","id":"t36o","name":"Grok","content":"Grok","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":360,"y":685.77},{"type":"text","id":"t36p","name":": Conversational flow, real-time informa","content":": Conversational flow, real-time information, humor","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":396.64,"y":685.77},{"type":"text","id":"t36q","name":"Using just one model means you’re leavin","content":"Using just one model means you’re leaving performance on the table.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":336,"y":734.57},{"type":"text","id":"t36r","name":"Building Effective Workflows","content":"Building Effective Workflows","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":336,"y":803.37},{"type":"text","id":"t36s","name":"Here’s how to combine models for better ","content":"Here’s how to combine models for better results:","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":336,"y":848.16},{"type":"text","id":"t36t","name":"Research + Writing","content":"Research + Writing","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":336,"y":908.96},{"type":"text","id":"t36u","name":"Use Claude to research and analyze your ","content":"Use Claude to research and analyze your topic thoroughly","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":949.76},{"type":"text","id":"t36v","name":"Pass the research to GPT-5 for creative,","content":"Pass the research to GPT-5 for creative, engaging content","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":986.55},{"type":"text","id":"t36w","name":"Use Claude again to fact-check the final","content":"Use Claude again to fact-check the final output","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1023.35},{"type":"text","id":"t36x","name":"Code Development","content":"Code Development","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":336,"y":1084.15},{"type":"text","id":"t36y","name":"Start with GPT-5 for rapid prototyping","content":"Start with GPT-5 for rapid prototyping","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1124.94},{"type":"text","id":"t36z","name":"Use Claude for code review and security ","content":"Use Claude for code review and security analysis","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1161.74},{"type":"text","id":"t370","name":"Switch to Gemini for documentation and v","content":"Switch to Gemini for documentation and visual explanations","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1198.54},{"type":"text","id":"t371","name":"Content Marketing","content":"Content Marketing","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":336,"y":1259.33},{"type":"text","id":"t372","name":"Use Grok for trending topic research wit","content":"Use Grok for trending topic research with real-time data","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1300.13},{"type":"text","id":"t373","name":"Draft content with GPT-5","content":"Draft content with GPT-5","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1336.93},{"type":"text","id":"t374","name":"Use Claude for tone and accuracy review","content":"Use Claude for tone and accuracy review","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1373.73},{"type":"text","id":"t375","name":"The Future of AI Is Multi-Model","content":"The Future of AI Is Multi-Model","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":336,"y":1442.52},{"type":"text","id":"t376","name