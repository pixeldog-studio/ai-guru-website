":885.76},{"type":"text","id":"t2g0","name":"Tips for Better Prompts","content":"Tips for Better Prompts","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":336,"y":954.55},{"type":"text","id":"t2g1","name":"Be specific","content":"Be specific","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":360,"y":999.35},{"type":"text","id":"t2g2","name":": Instead of “Write about dogs,” try “Wr","content":": Instead of “Write about dogs,” try “Write a 200-word blog post about the health","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":444.94,"y":999.35},{"type":"text","id":"t2g3","name":"benefits of adopting rescue dogs.”","content":"benefits of adopting rescue dogs.”","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":360,"y":1028.15},{"type":"text","id":"t2g4","name":"Provide context","content":"Provide context","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":360,"y":1064.94},{"type":"text","id":"t2g5","name":": Tell the AI who you are and what you n","content":": Tell the AI who you are and what you need the output for.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","x":480.47,"y":1064.94},{"type":"text","id":"t2g6","name":"Iterate","content":"Iterate","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-600","lineHeight":"$lineHeight-1_8","x":360,"y":1101.74},{"type":"text","id":"t2g7","name":": Don’t settle for the first response. R","conte