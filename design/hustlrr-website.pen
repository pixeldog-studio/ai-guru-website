","id":"P26o","name":"GH-22/A/blog-post/desktop/dark","reusable":false,"theme":{"mode":"dark"},"width":1440,"height":3036,"clip":true,"layout":"none","fill":"$bg-primary","children":[{"type":"frame","id":"f26n","name":"body","x":0,"y":0,"width":1440,"height":3036.28,"layout":"vertical","padding":[0,0,0,0],"children":[{"type":"frame","id":"f257","name":"main.pt-16","x":0,"y":0,"width":1440,"height":2675.28,"layout":"none","children":[{"type":"text","id":"t23x","name":"← Back to Blog","content":"← Back to Blog","fill":"$text-muted","fontFamily":"$font-inter-14","fontSize":"$fontSize-sm","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_429","x":336,"y":162.5},{"type":"ref","id":"r26p","ref":"f241","name":"header / desktop","x":336,"y":215},{"type":"text","id":"t245","name":"AI isn’t just a novelty — it’s a product","content":"AI isn’t just a novelty — it’s a productivity multiplier. Here are ten practical ways you can use AI models\nto save time and get more done every day.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":776.5,"x":336,"y":384.19},{"type":"text","id":"t246","name":"1. Email Drafting and Replies","content":"1. Email Drafting and Replies","fill":"$text-primary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_8","x":336,"y":481.79},{"type":"text","id":"t247","name":"Instead of staring at a blank screen, de","content":"Instead of staring at a blank screen, describe the email you need and let AI draft it. You’ll spend\nseconds editing instead of minutes composing.","fill":"$text-secondary","fontFamily":"$font-inter-16","fontSize":"$fontSize-base","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_8","textGrowth":"fixed-width","width":776.5,"x":336,"y":526.58},{"type":"text","id":"t248","name":"2. Meeting Summaries","content":"2. Meeting Summa