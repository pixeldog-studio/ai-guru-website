{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:all)",
      "Bash(npm run verify)",
      "Bash(npm run verify:full)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright install chromium)",
      "Bash(npx astro check)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
