---
import PageLayout from '@layouts/PageLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import ModelsSection from '@components/ModelsSection.astro';
import FeaturesSection from '@components/FeaturesSection.astro';
import TestimonialsSection from '@components/TestimonialsSection.astro';
const lang = 'en';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Hustlrr',
      url: 'https://www.hustlrr.ai',
      description:
        'Chat with the Best AI Models. One subscription for GPT-5, Claude, Gemini, Grok and more.',
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://www.hustlrr.ai/blog?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Hustlrr',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'iOS, iPadOS, macOS',
      description:
        'Chat with the best AI models. Use GPT-5, Claude, Gemini, Grok and more from one place.',
      url: 'https://www.hustlrr.ai',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
  ],
};
---

<PageLayout
  title="Hustlrr — Chat with the Best AI Models"
  description="Choose your AI model, ask anything, and compare how each one answers. Use GPT-5, Claude, Gemini, Grok and more from one place."
  lang={lang}
  jsonLd={jsonLd}
>
  <HeroSection lang={lang} />
  <ModelsSection lang={lang} />
  <FeaturesSection lang={lang} />
  <TestimonialsSection lang={lang} />
</PageLayout>
